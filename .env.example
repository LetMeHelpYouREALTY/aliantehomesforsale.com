# Local / Vercel
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare R2 (primary image CDN). Git public/ is the backup.
# Leave empty locally — Next.js serves /images and /og-image.jpg from public/.
# Production example (DNS-only / gray cloud, never orange-cloud the Vercel www host):
# NEXT_PUBLIC_CLOUDFLARE_MEDIA_BASE=https://media.aliantehomesforsale.com
NEXT_PUBLIC_CLOUDFLARE_MEDIA_BASE=

# Upload script (npm run media:upload) — never commit tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=aliante-homes-media
