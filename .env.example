# Local / Vercel
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Images (hosted assets — primary CDN).
# Hash is public in every imagedelivery.net URL. Never commit API tokens.
# Production (VERCEL_ENV=production) uses Images by default.
# Local and preview stay on git public/ unless set to true.
# Set false to force git (or R2) even on production.
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ENABLED=
NEXT_PUBLIC_CLOUDFLARE_IMAGES_HASH=byE6BTe9lNqo21V57n4aPQ
NEXT_PUBLIC_CLOUDFLARE_IMAGES_VARIANT=public

# Optional R2 tertiary CDN. Git public/ is the backup.
# Leave empty locally — Next.js serves /images and /og-image.jpg from public/.
# Gray-cloud host only — never orange-cloud the Vercel www host:
# NEXT_PUBLIC_CLOUDFLARE_MEDIA_BASE=https://media.aliantehomesforsale.com
NEXT_PUBLIC_CLOUDFLARE_MEDIA_BASE=

# Upload scripts (npm run media:upload) — never commit tokens.
# Token needs Account > Images > Edit. Optional: CLOUDFLARE_IMAGES_REPLACE=1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
R2_BUCKET=aliante-homes-media
